            "usuarios",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Sharon\",\n  \"email\": \"sharon@correo.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "8. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
