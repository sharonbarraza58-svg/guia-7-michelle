{
  "info": {
    "name": "Guia7 - Express + MongoDB",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Camiseta\",\n  \"precio\": 35000,\n  \"categoria\": \"ropa\",\n  \"stock\": 10\n}"
        }
      }
    },
    {
      "name": "2. Listar productos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "3. Producto por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/productos/ID_AQUI",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos",
            "ID_AQUI"
          ]
        }
      }
    },
    {
      "name": "4. Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/productos/ID_AQUI",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos",
            "ID_AQUI"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Camiseta\",\n  \"precio\": 40000,\n  \"categoria\": \"ropa\",\n  \"stock\": 10\n}"
        }
      }
    },
    {
      "name": "5. Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/productos/ID_AQUI",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos",
            "ID_AQUI"
          ]
        }
      }
    },
    {
      "name": "6. Productos por categoría",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/productos/categoria/ropa",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos",
            "categoria",
            "ropa"
          ]
        }
      }
    },
    {
